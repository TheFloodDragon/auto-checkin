{
  "version": 3,
  "accounts": [
    {
      "id": "example-newapi",
      "name": "示例 New API 站",
      "base_url": "https://example-newapi.com",
      "template": "newapi",
      "enabled": true,
      "login": {
        "method": "access_token",
        "args": { "user_id": "10000" }
      },
      "tasks": [
        { "id": "daily", "method": "http_api" }
      ],
      "credentials": {
        "access_token": "<在站点后台或用 collector.js 采集的 access_token>",
        "cookie": "<可选：session=... 等 Cookie，过 WAF 时需要>"
      }
    },

    {
      "id": "example-sub2api",
      "name": "示例 Sub2API 站",
      "base_url": "https://sub.example.com",
      "template": "sub2api",
      "enabled": true,
      "_说明": "留空 login.method 就是 auto：按模板的优先序依次尝试 token → refresh → 账密，成功的那条会被记住，下次直接命中。",
      "tasks": [
        { "id": "daily", "method": "http_api" }
      ],
      "credentials": {
        "access_token": "<浏览器 localStorage 的 auth_token / access_token>",
        "refresh_token": "<长效刷新令牌：有它就不必为 token 过期启动浏览器>"
      }
    },

    {
      "id": "example-agentrouter",
      "name": "示例 AgentRouter（OAuth 重登发放）",
      "base_url": "https://example-router.org",
      "template": "newapi",
      "enabled": true,
      "login": { "method": "oauth", "provider": "linuxdo", "account": "default" },
      "tasks": [
        { "id": "daily", "method": "relogin" }
      ]
    },

    {
      "id": "example-script",
      "name": "示例自定义模板站",
      "base_url": "https://example.100xlabs.space",
      "template": "scripts/tasks/100xlabs.py",
      "enabled": false,
      "_说明": "template 指向仓库内的模板文件时，它就是「自定义脚本」。模板与内置模板同级，可自由创建。",
      "login": {
        "method": "oauth",
        "provider": "linuxdo",
        "fallback": [
          { "method": "password", "args": { "email_env": "X100LABS_EMAIL", "password_env": "X100LABS_PASSWORD" } }
        ]
      },
      "tasks": [
        { "id": "daily", "method": "script", "timeout": 120, "args": { "start_path": "/check-in" } }
      ]
    },

    {
      "id": "example-multitask",
      "name": "示例多任务站（签到 + 答题）",
      "base_url": "https://jsd.example.com",
      "template": "scripts/tasks/jisudeng.py",
      "enabled": false,
      "_说明": "一个账号可以有多个任务；depends_on 让后置任务在前置未完成时判「不适用」而不是失败。同账号的任务共享一次登录与一次浏览器启动。",
      "tasks": [
        { "id": "daily", "method": "script", "title": "每日签到" },
        { "id": "quiz", "method": "script", "title": "每日答题", "depends_on": ["daily"], "args": { "quiz": true } }
      ]
    },

    {
      "id": "example-lucky-welfare",
      "name": "示例 Lucky 福利站（主站账号）",
      "base_url": "https://new.lucky0625.qzz.io",
      "template": "scripts/tasks/lucky_welfare.py",
      "enabled": false,
      "_说明": "主站地址保持不变；签到在 fuli.lucky0625.qzz.io 完成。登录使用同一个 LinuxDO 共享登录态，福利站 Cookie/browser_state 成功后由运行期覆盖层保存。",
      "login": { "method": "oauth", "provider": "linuxdo", "account": "default" },
      "tasks": [
        { "id": "daily", "method": "script", "title": "Lucky 福利站每日签到", "timeout": 240 }
      ]
    },

    {
      "id": "example-flow-control",
      "name": "示例：流程强控制",
      "base_url": "https://strict.example.com",
      "template": "newapi",
      "enabled": false,
      "_说明": "flow 逐阶段控制：auto=自动探测并复用结论；写死一个方式=只走它，失败就失败；数组=只在这个优先序内降级；off=关掉该阶段。未列出的阶段保持 auto。",
      "flow": {
        "login": ["access_token", "cookie"],
        "verification": "turnstile",
        "detect": "off"
      },
      "policy": {
        "tolerate_failure": false,
        "allow_browser": true,
        "headless": true
      },
      "network": {
        "proxy": "",
        "verify_ssl": true,
        "referer_path": "/profile"
      },
      "display": { "text_label": "额度" },
      "tasks": [
        { "id": "daily", "method": "http_api", "args": { "variant": "legacy" } }
      ]
    },

    {
      "id": "example-proxy-group",
      "name": "示例：走代理组",
      "base_url": "https://geo.example.com",
      "template": "newapi",
      "enabled": false,
      "_说明": "proxy_mode 四选一：inherit=用下面的 default_proxy_group（没设则回退 CHECKIN_PROXY，都没有则直连）；direct=明确直连且不回退环境代理；custom=用本账号的 network.proxy；group=用 network.proxy_group 里当前选中的节点。组为空/停用/未选节点时本账号报配置错误，不会悄悄改成直连。",
      "network": {
        "proxy_mode": "group",
        "proxy_group": "residential",
        "verify_ssl": true
      },
      "tasks": [
        { "id": "daily", "method": "http_api" }
      ]
    }
  ],

  "_代理组说明": "一组节点共享给多个账号；换出口只改组里的 selected，不用逐个账号改。selected 必须手动指定，框架不会自动测速或故障切换——静默换节点会让「今天为什么换了出口」无从追查。HTTP 层只支持 http/https（标准库限制），socks5 仅浏览器流程可用。",
  "proxy_groups": [
    {
      "id": "residential",
      "name": "住宅节点",
      "selected": "hk-1",
      "enabled": true,
      "proxies": [
        { "id": "hk-1", "name": "香港 1", "url": "http://user:pass%40word@127.0.0.1:7897", "enabled": true },
        { "id": "jp-1", "name": "东京 1", "url": "socks5://127.0.0.1:1080", "enabled": true },
        { "id": "us-1", "name": "美西 1（备用）", "url": "http://127.0.0.1:7898", "enabled": false }
      ]
    }
  ],
  "default_proxy_group": "",

  "oauth_states": {
    "linuxdo": {
      "accounts": {
        "default": {
          "state": "<用 GUI「捕获 OAuth 登录态」或 poc_oauth.py setup 生成的 base64 登录态>",
          "username": "",
          "updated_at": ""
        }
      }
    },
    "github": {
      "accounts": {
        "default": {
          "state": "<GitHub 共享登录态 base64>",
          "username": "",
          "updated_at": ""
        }
      }
    }
  }
}
